{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.types.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./projects/satoshi-ui/src",
    "composite": false,
    "incremental": false
  },
  "include": ["projects/satoshi-ui/src"],
  "exclude": [
    "dist",
    "node_modules",
    "projects/satoshi-ui/src/test",
    "**/*.test.*"
  ]
}
